{
  "name": "jcem.pro-sitemath",
  "version": "0.1.0",
  "description": "Runtime cliente e integracoes de build para a linguagem SiteMath.",
  "private": true,
  "license": "MPL-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agents:update": "node scripts/.agents/repo-tools.js agent:agents",
    "agent:agents": "node scripts/.agents/repo-tools.js agent:agents",
    "agent:filter": "node scripts/.agents/to-ia.js --command agent:filter",
    "agent:compress": "node scripts/.agents/repo-tools.js agent:compress",
    "agent:doctor": "node scripts/.agents/repo-tools.js agent:doctor",
    "agent:handoff": "node scripts/.agents/repo-tools.js agent:handoff",
    "agent:rcf": "node scripts/.agents/repo-tools.js agent:rcf",
    "agent:setup": "node scripts/.agents/repo-tools.js agent:setup",
    "agent:status": "node scripts/.agents/repo-tools.js agent:status",
    "agent:git-diff": "node scripts/.agents/repo-tools.js agent:git-diff",
    "agent:git-log": "node scripts/.agents/repo-tools.js agent:git-log",
    "agent:git-status": "node scripts/.agents/repo-tools.js agent:git-status"
  },
  "sitemath": {
    "schemaVersion": 1,
    "languageId": "jcem.pro/sitemath",
    "languageAliases": [
      "sitemath"
    ],
    "contentIdentifiers": {
      "markdownFence": "sitemath",
      "htmlScriptType": "text/x-sitemath",
      "manifestKey": "sitemath"
    },
    "detection": {
      "strategy": "exact-language-identifier",
      "falsePositivePolicy": "ignore-unrecognized-or-malformed-candidates"
    },
    "runtime": {
      "clientRequired": true,
      "defaultMaxIterations": 500,
      "configPrecedence": [
        "explicit-api",
        "exported-variable",
        "configuration-file",
        "default"
      ]
    },
    "buildAdapters": []
  },
  "agentsGovernance": {
    "schema": 1,
    "managedScriptPrefixes": [
      "agent:"
    ],
    "managedScripts": [
      "agents:update"
    ],
    "dependencies": [],
    "optionalDependencies": []
  }
}
