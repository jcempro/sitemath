{
  "name": "@jcem/sitemath",
  "version": "0.0.1",
  "description": "TypeScript-like declarative scripting language for forms, calculations, and content-driven interactivity, with secure browser execution and optional build-time detection.",
  "license": "MPL-2.0",
  "author": "JeanCarloEM (https://jeancarloem.com)",
  "repository": "https://github.com/jcempro/sitemath",
  "homepage": "https://sitemath.jcemp.pro",
  "type": "commonjs",
  "main": "dist/sitemath.js",
  "types": "dist/sitemath.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sitemath.d.ts",
      "require": "./dist/sitemath.js",
      "default": "./dist/sitemath.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run compile:tools && node .tmp/tools/scripts/sitemath-build.js",
    "check": "npm run lint && npm run test && npm run test:targets",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.tmp',{recursive:true,force:true})\"",
    "compile:tools": "tsc --project tsconfig.tools.json",
    "dev": "npm run compile:tools && node .tmp/tools/scripts/sitemath-serve.js",
    "detect": "npm run build && node .tmp/tools/scripts/sitemath-detect.js",
    "lint": "npm run typecheck",
    "typecheck": "tsc --project tsconfig.json",
    "test": "npm run build && node --test .tmp/tools/tests/sitemath.test.js",
    "test:targets": "npm run build && node .tmp/tools/scripts/test-targets.js",
    "test:targets:web": "npm run build && node .tmp/tools/scripts/test-targets.js --web",
    "test:targets:jekyll": "npm run build && node .tmp/tools/scripts/test-targets.js --jekyll",
    "validate:package": "npm run build && node .tmp/tools/scripts/validate-package.js",
    "release:publish": "npm run compile:tools && node .tmp/tools/scripts/release-publish.js",
    "agents:update": "node .agents/core/runtime/scripts/repo-tools.js agent:agents",
    "agent:agents": "node .agents/core/runtime/scripts/repo-tools.js agent:agents",
    "agent:filter": "node .agents/core/runtime/scripts/to-ia.js --command agent:filter",
    "agent:build": "node .agents/core/runtime/scripts/repo-tools.js agent:build",
    "agent:clean": "node .agents/core/runtime/scripts/repo-tools.js agent:clean",
    "agent:verify": "node .agents/core/runtime/scripts/repo-tools.js agent:verify",
    "agent:dist": "node .agents/core/runtime/scripts/repo-tools.js agent:dist",
    "agent:index": "node .agents/core/runtime/scripts/repo-tools.js agent:index",
    "agent:status": "node .agents/core/runtime/scripts/repo-tools.js agent:status",
    "agent:handoff": "node .agents/core/runtime/scripts/repo-tools.js agent:handoff",
    "agent:pwd": "node .agents/core/runtime/scripts/repo-tools.js agent:pwd",
    "agent:ls": "node .agents/core/runtime/scripts/repo-tools.js agent:ls",
    "agent:tree": "node .agents/core/runtime/scripts/repo-tools.js agent:tree",
    "agent:find": "node .agents/core/runtime/scripts/repo-tools.js agent:find",
    "agent:search": "node .agents/core/runtime/scripts/repo-tools.js agent:search",
    "agent:grep": "node .agents/core/runtime/scripts/repo-tools.js agent:grep",
    "agent:head": "node .agents/core/runtime/scripts/repo-tools.js agent:head",
    "agent:tail": "node .agents/core/runtime/scripts/repo-tools.js agent:tail",
    "agent:view": "node .agents/core/runtime/scripts/repo-tools.js agent:view",
    "agent:stat": "node .agents/core/runtime/scripts/repo-tools.js agent:stat",
    "agent:size": "node .agents/core/runtime/scripts/repo-tools.js agent:size",
    "agent:hash": "node .agents/core/runtime/scripts/repo-tools.js agent:hash",
    "agent:git-status": "node .agents/core/runtime/scripts/repo-tools.js agent:git-status",
    "agent:git-log": "node .agents/core/runtime/scripts/repo-tools.js agent:git-log",
    "agent:git-diff": "node .agents/core/runtime/scripts/repo-tools.js agent:git-diff",
    "agent:setup": "node .agents/core/runtime/scripts/repo-tools.js agent:setup",
    "agent:doctor": "node .agents/core/runtime/scripts/repo-tools.js agent:doctor",
    "agent:repair": "node .agents/core/runtime/scripts/repo-tools.js agent:repair",
    "agent:context": "node .agents/core/runtime/scripts/repo-tools.js agent:context",
    "agent:workspace": "node .agents/core/runtime/scripts/repo-tools.js agent:workspace",
    "agent:diff-file": "node .agents/core/runtime/scripts/repo-tools.js agent:diff-file",
    "agent:logs": "node .agents/core/runtime/scripts/repo-tools.js agent:logs",
    "agent:process": "node .agents/core/runtime/scripts/repo-tools.js agent:process",
    "agent:kill": "node .agents/core/runtime/scripts/repo-tools.js agent:kill",
    "agent:ports": "node .agents/core/runtime/scripts/repo-tools.js agent:ports",
    "agent:compress": "node .agents/core/runtime/scripts/repo-tools.js agent:compress",
    "agent:extract": "node .agents/core/runtime/scripts/repo-tools.js agent:extract",
    "agent:git-fetch": "node .agents/core/runtime/scripts/repo-tools.js agent:git-fetch",
    "agent:git-pull": "node .agents/core/runtime/scripts/repo-tools.js agent:git-pull",
    "agent:git-push": "node .agents/core/runtime/scripts/repo-tools.js agent:git-push",
    "agent:git-sync": "node .agents/core/runtime/scripts/repo-tools.js agent:git-sync",
    "agent:git-add": "node .agents/core/runtime/scripts/repo-tools.js agent:git-add",
    "agent:git-commit": "node .agents/core/runtime/scripts/repo-tools.js agent:git-commit",
    "agent:git-branch": "node .agents/core/runtime/scripts/repo-tools.js agent:git-branch",
    "agent:git-switch": "node .agents/core/runtime/scripts/repo-tools.js agent:git-switch",
    "agent:git-tag": "node .agents/core/runtime/scripts/repo-tools.js agent:git-tag",
    "agent:git-show": "node .agents/core/runtime/scripts/repo-tools.js agent:git-show",
    "agent:git-history": "node .agents/core/runtime/scripts/repo-tools.js agent:git-history",
    "agent:git-blame": "node .agents/core/runtime/scripts/repo-tools.js agent:git-blame",
    "agent:git-reset": "node .agents/core/runtime/scripts/repo-tools.js agent:git-reset",
    "agent:git-restore": "node .agents/core/runtime/scripts/repo-tools.js agent:git-restore",
    "agent:git-clean": "node .agents/core/runtime/scripts/repo-tools.js agent:git-clean",
    "agent:git-stash": "node .agents/core/runtime/scripts/repo-tools.js agent:git-stash",
    "agent:git-prune": "node .agents/core/runtime/scripts/repo-tools.js agent:git-prune",
    "agent:git-gc": "node .agents/core/runtime/scripts/repo-tools.js agent:git-gc",
    "agent:git-last-release": "node .agents/core/runtime/scripts/repo-tools.js agent:git-last-release",
    "agent:git-release-notes": "node .agents/core/runtime/scripts/repo-tools.js agent:git-release-notes",
    "agent:git-changelog": "node .agents/core/runtime/scripts/repo-tools.js agent:git-changelog",
    "agent:package": "node .agents/core/runtime/scripts/repo-tools.js agent:package",
    "agent:release": "node .agents/core/runtime/scripts/repo-tools.js agent:release",
    "agent:release:trigger": "node .agents/core/runtime/scripts/repo-tools.js agent:release:trigger",
    "agent:release:publish": "node .agents/core/runtime/scripts/to-ia.js --command agent:release:publish --run node .agents/scenarios/release/scripts/release-publish-resume.js",
    "agent:rollback": "node .agents/core/runtime/scripts/repo-tools.js agent:rollback",
    "agent:test": "node .agents/core/runtime/scripts/repo-tools.js agent:test",
    "agent:lint": "node .agents/core/runtime/scripts/repo-tools.js agent:lint",
    "agent:format": "node .agents/core/runtime/scripts/repo-tools.js agent:format",
    "agent:typecheck": "node .agents/core/runtime/scripts/repo-tools.js agent:typecheck",
    "agent:benchmark": "node .agents/core/runtime/scripts/repo-tools.js agent:benchmark",
    "agent:security": "node .agents/core/runtime/scripts/repo-tools.js agent:security",
    "agent:analyze": "node .agents/core/runtime/scripts/repo-tools.js agent:analyze",
    "agent:deps": "node .agents/core/runtime/scripts/repo-tools.js agent:deps",
    "agent:update-deps": "node .agents/core/runtime/scripts/repo-tools.js agent:update-deps",
    "agent:licenses": "node .agents/core/runtime/scripts/repo-tools.js agent:licenses",
    "agent:map": "node .agents/core/runtime/scripts/repo-tools.js agent:map",
    "agent:docs": "node .agents/core/runtime/scripts/repo-tools.js agent:docs",
    "agent:rcf": "node .agents/core/runtime/scripts/repo-tools.js agent:rcf",
    "agent:parse-data": "node .agents/core/runtime/scripts/repo-tools.js agent:parse-data",
    "agent:summarize": "node .agents/core/runtime/scripts/repo-tools.js agent:summarize",
    "agent:convert": "node .agents/core/runtime/scripts/repo-tools.js agent:convert",
    "agent:validate-data": "node .agents/core/runtime/scripts/repo-tools.js agent:validate-data",
    "agent:index-data": "node .agents/core/runtime/scripts/repo-tools.js agent:index-data",
    "agent:query-data": "node .agents/core/runtime/scripts/repo-tools.js agent:query-data"
  },
  "sitemath": {
    "schemaVersion": 1,
    "languageId": "jcem.pro/sitemath",
    "languageAliases": [
      "sitemath"
    ],
    "contentIdentifiers": {
      "markdownFence": "sitemath",
      "htmlScriptType": "text/x-sitemath",
      "manifestKey": "sitemath"
    },
    "detection": {
      "strategy": "exact-language-identifier",
      "falsePositivePolicy": "ignore-unrecognized-or-malformed-candidates"
    },
    "runtime": {
      "clientRequired": true,
      "defaultMaxIterations": 500,
      "configPrecedence": [
        "explicit-api",
        "exported-variable",
        "configuration-file",
        "default"
      ]
    },
    "buildAdapters": [
      {
        "id": "node",
        "runtime": "node",
        "module": "dist/sitemath.js",
        "export": "createNodeAdapter",
        "version": 1
      }
    ]
  },
  "agentsGovernance": {
    "schema": 1,
    "managedScriptPrefixes": [
      "agent:"
    ],
    "managedScripts": [
      "agents:update"
    ],
    "dependencies": [],
    "optionalDependencies": []
  },
  "browserslist": [
    "baseline widely available with downstream"
  ],
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "browserslist": "^4.28.6",
    "browserslist-to-esbuild": "^2.1.1",
    "preact": "^10.29.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
